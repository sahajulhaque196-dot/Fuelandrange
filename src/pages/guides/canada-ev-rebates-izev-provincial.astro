---
// src/pages/guides/canada-ev-rebates-izev-provincial.astro
// Pillar Guide: Canada EV Rebates & Incentives — Updated for 2024–2026 reality
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbSchema, authorPersonSchema, orgSchema } from '../../lib/schema.ts';

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Guides', url: '/guides' },
    { name: 'Canada EV Rebates Guide', url: '/guides/canada-ev-rebates-izev-provincial' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Canada EV Rebates & Incentives Guide 2024–2026: Federal iZEV Closure & 2026 EVAP Framework',
    description: 'Complete guide to Canadian electric vehicle incentive programs: federal iZEV transition, the federal Electric Vehicle Affordability Program (EVAP), and active provincial EV rebates in Quebec, BC, Nova Scotia, PEI, and New Brunswick.',
    author: authorPersonSchema(),
    publisher: orgSchema(),
    datePublished: '2024-03-01',
    dateModified: '2026-09-02',
    mainEntityOfPage: 'https://rangeandfuel.ca/guides/canada-ev-rebates-izev-provincial',
  },
];
---

<BaseLayout
  title="Canada EV Rebates & Incentives Guide 2024–2026 | RangeAndFuel.ca"
  description="Complete guide to Canadian electric vehicle incentives: federal iZEV transition, the federal EVAP framework, and active provincial EV rebates in Quebec, BC, Nova Scotia, PEI, and New Brunswick."
  canonical="/guides/canada-ev-rebates-izev-provincial"
  jsonLd={jsonLd}
>
  <!-- Breadcrumb Bar -->
  <div class="border-b border-white/[0.06] bg-[#07090E]/80 backdrop-blur-md">
    <div class="container-site py-3">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-xs text-slate-400 font-mono">
          <li><a href="/" class="hover:text-neon-cyan transition-colors">Home</a></li>
          <li class="text-slate-600">/</li>
          <li><a href="/guides" class="hover:text-neon-cyan transition-colors">Guides</a></li>
          <li class="text-slate-600">/</li>
          <li class="text-slate-200 font-medium">Canada EV Rebates</li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- Article Header -->
  <header class="py-14 md:py-18 bg-[#06080C] border-b border-white/[0.08] relative overflow-hidden">
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-gradient-to-b from-emerald-500/15 via-neon-cyan/5 to-transparent blur-3xl pointer-events-none rounded-full"></div>

    <div class="container-site max-w-4xl relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono mb-4">
        <span>🍁</span> Canadian Clean Transportation Financial Analysis
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-black text-white tracking-tight leading-tight">
        Canada EV Rebates Guide: <br />
        <span class="text-gradient-green">Provincial Programs & iZEV History</span>
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-xs font-mono text-slate-400 mt-6 pt-6 border-t border-white/[0.06]">
        <span>By <strong>Sahajul Haque</strong> · Lead Data Architect</span>
        <span>•</span>
        <span>Consumer Financial Analysis</span>
        <span>•</span>
        <span>8 Min Read</span>
        <span>•</span>
        <span class="text-emerald-400">Updated September 2026 · Transport Canada Verified</span>
      </div>
    </div>
  </header>

  <!-- Article Body -->
  <article class="py-16 md:py-20 bg-[#07090E]">
    <div class="container-site max-w-3xl space-y-10 text-slate-300 text-sm leading-relaxed">

      <!-- CRITICAL NOTICE: iZEV Transition to EVAP -->
      <div class="p-6 sm:p-8 rounded-3xl bg-cyan-500/5 border border-cyan-500/30 shadow-xl space-y-3">
        <h2 class="text-base font-bold text-neon-cyan font-mono uppercase tracking-wider flex items-center gap-2">
          <span>ℹ️</span> Important Federal EV Program Update
        </h2>
        <p>
          The original <strong class="text-white">Transport Canada iZEV program</strong> officially concluded after all allocated funding was fully committed in <strong class="text-white">January 2025</strong>. It was succeeded by the federal <strong class="text-emerald-400">Electric Vehicle Affordability Program (EVAP)</strong>, providing up to <strong class="text-white">$5,000 CAD</strong> for eligible zero-emission vehicles with a transaction value cap of $50,000 CAD, alongside active provincial rebates.
        </p>
        <p class="text-xs text-slate-400">
          Source: <a href="https://tc.canada.ca/en/road-transportation/innovative-technologies/zero-emission-vehicles" target="_blank" rel="noopener noreferrer nofollow" class="text-neon-cyan hover:underline">Transport Canada Clean Transportation</a> · Last verified: September 2026.
        </p>
      </div>

      <!-- Section 1: iZEV Historical Background -->
      <section class="space-y-4">
        <h2 class="text-2xl font-display font-bold text-white">
          1. Federal EV Incentive Evolution — iZEV & The 2026 EVAP Program
        </h2>
        <p>
          Originally launched in May 2019, the federal <strong>Incentives for Zero-Emission Vehicles (iZEV)</strong> program provided point-of-sale rebates directly on vehicle bills of sale. Following its record adoption and fund exhaustion, the program paved the way for the modernized <strong>Electric Vehicle Affordability Program (EVAP)</strong>.
        </p>
        <p>
          Core incentive tiers under the federal framework provide:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-5 rounded-2xl bg-[#0D1117] border border-slate-700/50">
            <span class="text-2xl font-black font-mono text-slate-400 block mb-1">$5,000 CAD <span class="text-sm text-rose-400 font-normal">(Historical)</span></span>
            <h3 class="font-bold text-white text-sm mb-2">Battery-Electric & Long-Range PHEV</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Applied to all pure BEVs and PHEVs with NRCan electric range ≥ 50 km. Program ended March 31, 2024.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-[#0D1117] border border-slate-700/50">
            <span class="text-2xl font-black font-mono text-slate-400 block mb-1">$2,500 CAD <span class="text-sm text-rose-400 font-normal">(Historical)</span></span>
            <h3 class="font-bold text-white text-sm mb-2">Short-Range Plug-in Hybrids</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Applied to PHEVs with NRCan electric range under 50 km. Program ended March 31, 2024.
            </p>
          </div>
        </div>
        <div class="p-4 rounded-2xl bg-[#06080C] border border-white/[0.06] text-xs text-slate-400">
          <strong class="text-white">Former MSRP Eligibility Caps (Historical Reference):</strong>
          <ul class="list-disc pl-5 mt-1.5 space-y-1">
            <li><strong>Passenger Cars:</strong> Base trim MSRP under $55,000 CAD; eligible up to $65,000 CAD for higher trims.</li>
            <li><strong>Station Wagons, Pickups & SUVs:</strong> Base trim MSRP under $60,000 CAD; eligible up to $70,000 CAD.</li>
          </ul>
        </div>
      </section>

      <!-- Section 2: Active Provincial Programs 2024–2026 -->
      <section class="space-y-4">
        <h2 class="text-2xl font-display font-bold text-white">
          2. Active Provincial EV Incentive Programs (2024–2026)
        </h2>
        <p>
          While the federal program has ended, several Canadian provinces maintain their own independent electric vehicle rebate programs. These are administered at the provincial level and do not require federal stacking.
        </p>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono border border-white/[0.08] rounded-xl overflow-hidden">
            <thead class="bg-[#0D1117] text-slate-400 border-b border-white/[0.08]">
              <tr>
                <th class="p-3">Province</th>
                <th class="p-3">Program Name</th>
                <th class="p-3">Max Rebate</th>
                <th class="p-3">Status (2026)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.04] text-slate-300">
              <tr>
                <td class="p-3 font-bold text-white">Quebec</td>
                <td class="p-3">Roulez vert</td>
                <td class="p-3 text-emerald-400 font-bold">Up to $7,000</td>
                <td class="p-3"><span class="text-emerald-400 font-bold">✓ Active</span></td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-white">British Columbia</td>
                <td class="p-3">CleanBC Go Electric</td>
                <td class="p-3 text-emerald-400 font-bold">Up to $4,000</td>
                <td class="p-3"><span class="text-emerald-400 font-bold">✓ Active</span></td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-white">Nova Scotia</td>
                <td class="p-3">Electrify NS</td>
                <td class="p-3 text-emerald-400 font-bold">$3,000</td>
                <td class="p-3"><span class="text-emerald-400 font-bold">✓ Active</span></td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-white">New Brunswick</td>
                <td class="p-3">Electric Vehicle Rebate</td>
                <td class="p-3 text-emerald-400 font-bold">Up to $5,000</td>
                <td class="p-3"><span class="text-emerald-400 font-bold">✓ Active</span></td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-white">Prince Edward Island</td>
                <td class="p-3">EV Incentive Program</td>
                <td class="p-3 text-emerald-400 font-bold">Up to $5,000</td>
                <td class="p-3"><span class="text-emerald-400 font-bold">✓ Active</span></td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-slate-400">Ontario</td>
                <td class="p-3 text-slate-500">—</td>
                <td class="p-3 text-slate-500">$0</td>
                <td class="p-3"><span class="text-slate-500">No provincial rebate</span></td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-slate-400">Alberta</td>
                <td class="p-3 text-slate-500">—</td>
                <td class="p-3 text-slate-500">$0</td>
                <td class="p-3"><span class="text-slate-500">No provincial rebate</span></td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-slate-400">Saskatchewan</td>
                <td class="p-3 text-slate-500">—</td>
                <td class="p-3 text-slate-500">$0</td>
                <td class="p-3"><span class="text-slate-500">No provincial rebate</span></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-xs text-slate-500 italic">
          Note: Provincial program terms, eligibility caps, and availability change frequently. Always verify current status directly with the provincial ministry before purchase.
          <a href="https://natural-resources.canada.ca/energy-efficiency/transportation-alternative-fuels/electric-personal-vehicles/buying-electric-vehicle/ev-charging-incentives/incentives-electric-light-duty-vehicles/21889" target="_blank" rel="noopener noreferrer nofollow" class="text-neon-cyan hover:underline ml-1">NRCan incentive reference →</a>
        </p>
      </section>

      <!-- Section 3: Quebec — Most Generous Province -->
      <section class="space-y-4">
        <h2 class="text-2xl font-display font-bold text-white">
          3. Quebec (Roulez vert) — Canada's Most Generous EV Province
        </h2>
        <p>
          Quebec's <strong>Roulez vert</strong> (Drive Green) program, administered by Transition énergétique Québec (TEQ), remains the most generous provincial EV incentive in Canada as of 2026. The rebate applies at point-of-sale for eligible new BEVs and PHEVs purchased or leased in Quebec.
        </p>
        <ul class="list-disc pl-5 space-y-2 text-slate-400">
          <li><strong class="text-white">BEVs:</strong> Up to $7,000 CAD rebate on purchase or 4-year lease</li>
          <li><strong class="text-white">PHEVs:</strong> Up to $4,000 CAD on eligible plug-in hybrid models</li>
          <li><strong class="text-white">MSRP Caps:</strong> Generally under $65,000 CAD base MSRP</li>
          <li><strong class="text-white">Used EVs:</strong> Separate rebate of up to $4,000 for eligible used BEVs</li>
        </ul>
        <p>
          For Quebec residents, the Roulez vert rebate alone remains one of the strongest incentives available in Canada after the end of the federal iZEV program. Source: <a href="https://www.roulezvert.gouv.qc.ca/" target="_blank" rel="noopener noreferrer nofollow" class="text-neon-cyan hover:underline">Roulez vert official program page</a>.
        </p>
      </section>

      <!-- Section 4: BC CleanBC -->
      <section class="space-y-4">
        <h2 class="text-2xl font-display font-bold text-white">
          4. British Columbia (CleanBC Go Electric)
        </h2>
        <p>
          British Columbia's <strong>CleanBC Go Electric</strong> program offers rebates through the BC Scrap-It program and Point-of-Sale Incentive (POSI) via participating dealerships. The program is funded through the Province of BC and managed by the New Vehicle Dealers Association of BC.
        </p>
        <ul class="list-disc pl-5 space-y-2 text-slate-400">
          <li><strong class="text-white">BEVs (new):</strong> Up to $4,000 CAD (MSRP under $77,000 CAD)</li>
          <li><strong class="text-white">PHEVs (new):</strong> Up to $2,000 CAD on eligible plug-in hybrid models</li>
          <li><strong class="text-white">Used BEVs:</strong> Up to $4,000 CAD (household income under $80,000; MSRP under $55,000)</li>
        </ul>
        <p>
          Source: <a href="https://goelectricbc.gov.bc.ca/" target="_blank" rel="noopener noreferrer nofollow" class="text-neon-cyan hover:underline">Go Electric BC official page</a>.
        </p>
      </section>

      <!-- Section 5: Leasing Impact -->
      <section class="space-y-4">
        <h2 class="text-2xl font-display font-bold text-white">
          5. How Leasing Impacts Provincial Rebate Values
        </h2>
        <p>
          Most provincial programs prorate the rebate amount based on lease duration. For Quebec's Roulez vert program as a reference example:
        </p>
        <ul class="list-disc pl-5 space-y-1 text-slate-400 text-xs">
          <li><strong>48-Month Lease:</strong> 100% of the maximum provincial rebate.</li>
          <li><strong>36-Month Lease:</strong> 75% of the rebate value.</li>
          <li><strong>24-Month Lease:</strong> 50% of the rebate value.</li>
          <li><strong>12-Month Lease:</strong> 25% of the rebate value.</li>
        </ul>
        <p>
          Always confirm lease rebate proration rules directly with your province's program administrator, as terms differ between provinces and are updated periodically.
        </p>
      </section>

      <!-- Section 6: Future Federal Programs -->
      <section class="space-y-4">
        <h2 class="text-2xl font-display font-bold text-white">
          6. Will Canada Reinstate a Federal EV Rebate?
        </h2>
        <p>
          As of September 2026, there is no confirmed plan by the Government of Canada to reinstate a national electric vehicle purchase rebate program equivalent to the former iZEV. The 2024 federal budget redirected clean transportation funding toward charging infrastructure and fleet electrification rather than consumer purchase incentives.
        </p>
        <p>
          Canadian automotive industry groups including the Canadian Vehicle Manufacturers' Association (CVMA) and the Zero Emission Vehicle Association (ZEVA) have continued to advocate for the reinstatement of consumer incentives at the federal level. RangeAndFuel.ca will update this guide if a new federal program is announced.
        </p>
        <div class="p-4 rounded-2xl bg-[#06080C] border border-neon-cyan/10 text-xs text-slate-400">
          <strong class="text-neon-cyan">Data Accuracy Notice:</strong> All program statuses in this guide were verified as of September 2026 using official government sources.
          Provincial programs change frequently — verify current status at your province's transportation ministry website before making a vehicle purchase decision.
        </div>
      </section>

    </div>
  </article>
</BaseLayout>
