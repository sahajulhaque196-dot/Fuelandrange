---
// src/pages/makes/[make]/[model]/[year]/[trim].astro
// High-grade Canadian Trim Intelligence Money Page
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import FuelCostCalculator from '../../../../../components/calculators/FuelCostCalculator.tsx';
import WinterPenaltyMeter from '../../../../../components/calculators/WinterPenaltyMeter.tsx';
import LeadGenWidget from '../../../../../components/widgets/LeadGenWidget.tsx';
import vehicles from '../../../../../data/vehicles.json';
import fuelPrices from '../../../../../data/fuel-prices.json';
import { vehicleSchema, faqSchema, breadcrumbSchema } from '../../../../../lib/schema.ts';
import { toSlug, calcHwyRange, fuelTypePill, fuelTypeLabel, isBEV, isPHEV } from '../../../../../lib/calculations.ts';
import type { Vehicle } from '../../../../../lib/calculations.ts';

export async function getStaticPaths() {
  const all = vehicles as unknown as Vehicle[];
  return all.map(v => ({
    params: {
      make:  toSlug(v.make),
      model: toSlug(v.model),
      year:  String(v.year),
      trim:  toSlug(v.trim),
    },
    props: { vehicleId: v.id },
  }));
}

const { make, model, year, trim } = Astro.params;
const { vehicleId } = Astro.props;

const all      = vehicles as unknown as Vehicle[];
const vehicle  = all.find(v => v.id === vehicleId) as Vehicle;
const provinces = (fuelPrices as any).provinces;
const hwyRange  = calcHwyRange(vehicle);
const isEV      = isBEV(vehicle);
const isPlugin  = isPHEV(vehicle);

// Sibling trims for fast comparison
const siblingTrims = all.filter(v => v.make === vehicle.make && v.model === vehicle.model && v.year === vehicle.year);

const jsonLd = [
  vehicleSchema(vehicle, `/makes/${make}/${model}/${year}/${trim}`),
  faqSchema(vehicle),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: vehicle.make, url: `/makes/${make}` },
    { name: vehicle.model, url: `/makes/${make}/${model}` },
    { name: String(vehicle.year), url: `/makes/${make}/${model}/${year}` },
    { name: vehicle.trim, url: `/makes/${make}/${model}/${year}/${trim}` },
  ]),
];
---

<BaseLayout
  title={`${vehicle.year} ${vehicle.make} ${vehicle.model} ${vehicle.trim} — Fuel Economy & Range Canada | RangeAndFuel.ca`}
  description={`${vehicle.year} ${vehicle.make} ${vehicle.model} ${vehicle.trim}: ${vehicle.combinedL100km ? `${vehicle.combinedL100km} L/100km combined` : `${vehicle.kwhPer100km} kWh/100km`}. Official NRCan ratings, provincial CAD fuel costs, and -15°C winter range model.`}
  canonical={`/makes/${make}/${model}/${year}/${trim}`}
  jsonLd={jsonLd}
>
  <!-- Top Navigation Breadcrumb -->
  <div class="border-b border-white/[0.06] bg-[#07090E]/80 backdrop-blur-md">
    <div class="container-site py-3">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-xs text-slate-400 font-mono flex-wrap">
          <li><a href="/" class="hover:text-neon-cyan transition-colors">Home</a></li>
          <li class="text-slate-600">/</li>
          <li><a href={`/makes/${make}`} class="hover:text-neon-cyan transition-colors">{vehicle.make}</a></li>
          <li class="text-slate-600">/</li>
          <li><a href={`/makes/${make}/${model}`} class="hover:text-neon-cyan transition-colors">{vehicle.model}</a></li>
          <li class="text-slate-600">/</li>
          <li><a href={`/makes/${make}/${model}/${year}`} class="hover:text-neon-cyan transition-colors">{vehicle.year}</a></li>
          <li class="text-slate-600">/</li>
          <li class="text-slate-200 font-medium truncate max-w-[220px]">{vehicle.trim}</li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- Full-Width Immersive Hero Header -->
  <header class="relative py-12 md:py-16 bg-[#06080C] border-b border-white/[0.06] overflow-hidden">
    <!-- Ambient Radial Glow -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[900px] h-[400px] bg-gradient-to-b from-neon-cyan/15 via-emerald-500/5 to-transparent blur-3xl pointer-events-none rounded-full"></div>
    <div class="absolute inset-0 bg-cyber-grid bg-[size:32px_32px] opacity-10 pointer-events-none"></div>

    <div class="container-site relative z-10">
      
      <!-- Badges Row -->
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class={fuelTypePill(vehicle.fuelType)}>{fuelTypeLabel(vehicle.fuelType)}</span>
        <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-white/[0.04] border border-white/[0.08] text-slate-300">
          {vehicle.vehicleClass}
        </span>
        <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-md bg-neon-cyan/10 border border-neon-cyan/20 text-neon-cyan">
          {vehicle.driveType} Drivetrain
        </span>
        <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
          NRCan EnerGuide Certified
        </span>
      </div>

      <!-- Title & Trim Header with Integrated MSRP -->
      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-black text-white tracking-tight leading-tight">
          {vehicle.year} {vehicle.make} {vehicle.model}
        </h1>
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 mt-2">
          <span class="text-xl sm:text-2xl text-neon-cyan font-bold tracking-tight">
            {vehicle.trim}
          </span>
          <span class="text-slate-700 font-mono">/</span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs sm:text-sm font-mono font-bold">
            <span class="text-[11px] text-slate-400 font-normal uppercase">Starting MSRP:</span>
            ${vehicle.msrpCAD.toLocaleString()} CAD
          </span>
          <span class="text-slate-700 font-mono hidden sm:inline">/</span>
          <span class="text-xs font-mono text-slate-400 hidden sm:inline">
            {vehicle.engineSize > 0 ? `${vehicle.engineSize}L ${vehicle.cylinders}-Cyl (${vehicle.transmission})` : 'Electric Dual Drive'}
          </span>
        </div>
      </div>

      <!-- 4 Prominent Stat Pillars -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        
        <!-- Combined Rating -->
        <div class="p-5 rounded-2xl bg-[#0D1117] border border-emerald-500/30 shadow-lg shadow-emerald-500/5 relative overflow-hidden group">
          <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1">NRCan Combined</div>
          <div class="text-3xl font-mono font-black text-emerald-400">
            {vehicle.combinedL100km ? `${vehicle.combinedL100km}` : `${vehicle.kwhPer100km}`}
          </div>
          <div class="text-xs font-mono text-slate-400 mt-1">
            {vehicle.combinedL100km ? 'L / 100 km' : 'kWh / 100 km'}
          </div>
        </div>

        <!-- City Driving -->
        <div class="p-5 rounded-2xl bg-[#0D1117] border border-white/[0.08]">
          <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1">City Driving</div>
          <div class="text-3xl font-mono font-black text-amber-400">
            {vehicle.cityL100km ? `${vehicle.cityL100km}` : vehicle.cityLe100km ? `${vehicle.cityLe100km}` : '—'}
          </div>
          <div class="text-xs font-mono text-slate-400 mt-1">
            {vehicle.cityL100km ? 'L / 100 km' : 'Le / 100 km'}
          </div>
        </div>

        <!-- Highway Driving -->
        <div class="p-5 rounded-2xl bg-[#0D1117] border border-white/[0.08]">
          <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1">Highway Cruising</div>
          <div class="text-3xl font-mono font-black text-cyan-400">
            {vehicle.hwyL100km ? `${vehicle.hwyL100km}` : vehicle.hwyLe100km ? `${vehicle.hwyLe100km}` : '—'}
          </div>
          <div class="text-xs font-mono text-slate-400 mt-1">
            {vehicle.hwyL100km ? 'L / 100 km' : 'Le / 100 km'}
          </div>
        </div>

        <!-- Range or Highway Range -->
        <div class="p-5 rounded-2xl bg-[#0D1117] border border-white/[0.08]">
          <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mb-1">
            {isEV ? 'Electric Range' : 'Cruising Range'}
          </div>
          <div class="text-3xl font-mono font-black text-neon-cyan">
            {isEV && vehicle.electricRangeKm 
              ? `${vehicle.electricRangeKm}` 
              : hwyRange 
              ? `${hwyRange}` 
              : '—'}
          </div>
          <div class="text-xs font-mono text-slate-400 mt-1">Kilometers (km)</div>
        </div>

      </div>

    </div>
  </header>

  <!-- Main 2-Column Body Stream with Sticky Sidebar -->
  <section class="py-12 md:py-16 bg-[#07090E]">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        <!-- ── Left Column: Primary Content (8 Cols) ────────────────── -->
        <div class="lg:col-span-8 space-y-12">
          
          <!-- 1. Canadian Road Test & Cold Climate (-15°C) Analysis -->
          <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-mono font-bold text-neon-cyan uppercase tracking-wider">🍁 Canadian Operational Reality</span>
            </div>
            
            <h2 class="text-2xl font-display font-black text-white mb-6">
              Cold Weather & Commuting Analysis
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
              <!-- Metric 1 -->
              <div class="p-4 rounded-2xl bg-[#06080C] border border-white/[0.06]">
                <div class="text-xs font-mono text-slate-400 mb-1">Annual 20,000 km Volume</div>
                <div class="text-xl font-mono font-black text-emerald-400 mb-1">
                  {vehicle.combinedL100km 
                    ? `${Math.round(vehicle.combinedL100km * 200)} Litres` 
                    : `${Math.round((vehicle.kwhPer100km || 18) * 200)} kWh`}
                </div>
                <p class="text-[11px] text-slate-500 leading-normal">
                  Standard 55% city / 45% highway commute.
                </p>
              </div>

              <!-- Metric 2 -->
              <div class="p-4 rounded-2xl bg-[#06080C] border border-rose-500/20">
                <div class="text-xs font-mono text-rose-400 mb-1 flex items-center gap-1">
                  <span>❄️</span> -15°C Winter Impact
                </div>
                <div class="text-xl font-mono font-black text-rose-400 mb-1">
                  {isEV && vehicle.electricRangeKm 
                    ? `~${Math.round(vehicle.electricRangeKm * 0.68)} km` 
                    : vehicle.combinedL100km 
                    ? `~${(vehicle.combinedL100km * 1.15).toFixed(1)} L/100km` 
                    : '—'}
                </div>
                <p class="text-[11px] text-slate-500 leading-normal">
                  {isEV ? 'Estimated 32% cabin heating range drop.' : 'Cold-start warmup fuel penalty.'}
                </p>
              </div>

              <!-- Metric 3 -->
              <div class="p-4 rounded-2xl bg-[#06080C] border border-cyan-500/20">
                <div class="text-xs font-mono text-cyan-400 mb-1">Refuel / Fast Charge</div>
                <div class="text-xl font-mono font-black text-cyan-400 mb-1">
                  {isEV ? '28 mins (DC Fast)' : '3 mins at Pump'}
                </div>
                <p class="text-[11px] text-slate-500 leading-normal">
                  {isEV ? '10% to 80% at 150kW Canadian fast charger.' : `${vehicle.fuelTankLitres || 55}L tank capacity.`}
                </p>
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-[#06080C] border border-white/[0.04] text-xs text-slate-300 leading-relaxed">
              <h3 class="font-bold text-white mb-1.5 font-display text-sm">🍁 Canadian Highway & Commuting Assessment:</h3>
              <p>
                The <strong>{vehicle.year} {vehicle.make} {vehicle.model} ({vehicle.trim})</strong> provides an official EnerGuide combined rating of 
                <strong>{vehicle.combinedL100km ? `${vehicle.combinedL100km} L/100km` : `${vehicle.kwhPer100km} kWh/100km`}</strong>. 
                Equipped with {vehicle.driveType} traction, it is optimized for high-stability handling across Ontario 401 corridors, Quebec Autoroutes, and Western Canadian mountain passes.
              </p>
            </div>
          </div>

          <!-- 2. 🇨🇦 10-Province Financial Energy Intelligence Table -->
          <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
              <div>
                <span class="text-xs font-mono text-emerald-400 uppercase tracking-widest font-semibold block mb-1">🇨🇦 Financial Cost Breakdown</span>
                <h2 class="text-2xl font-display font-black text-white">Annual Costs by Canadian Province</h2>
              </div>
              <p class="text-xs text-slate-400">Based on 20,000 km annual Canadian driving</p>
            </div>

            <div class="rounded-2xl bg-[#06080C] border border-white/[0.08] overflow-hidden">
              <div class="overflow-x-auto">
                <table class="w-full text-left text-xs font-mono">
                  <thead class="bg-[#07090E] text-slate-400 border-b border-white/[0.08]">
                    <tr>
                      <th class="p-3.5">Province</th>
                      <th class="p-3.5">Local Rate</th>
                      <th class="p-3.5">Cost / 100 km</th>
                      <th class="p-3.5">Annual (20k km)</th>
                      <th class="p-3.5 text-right">Monthly Spend</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-white/[0.04] text-slate-300">
                    {provinces.map((p: any) => {
                      let costPer100 = 0;
                      let annualCost = 0;
                      if (isEV) {
                        const kwh100 = vehicle.kwhPer100km || 18.0;
                        costPer100 = (kwh100 * (p.electricityCentsPerKwh / 100));
                        annualCost = Math.round(costPer100 * 200);
                      } else {
                        const litres100 = vehicle.combinedL100km || 8.0;
                        costPer100 = (litres100 * (p.gasolineCentsPerL / 100));
                        annualCost = Math.round(costPer100 * 200);
                      }
                      const monthlyCost = Math.round(annualCost / 12);

                      return (
                        <tr class="hover:bg-white/[0.02] transition-colors">
                          <td class="p-3.5 font-bold text-white flex items-center gap-2">
                            <span class="px-1.5 py-0.5 rounded bg-cyan-500/10 text-neon-cyan border border-cyan-500/20 text-[10px]">
                              {p.code}
                            </span>
                            <span class="font-sans font-medium text-xs">{p.name}</span>
                          </td>
                          <td class="p-3.5 text-slate-400">
                            {isEV ? `${p.electricityCentsPerKwh.toFixed(1)}¢/kWh` : `${p.gasolineCentsPerL.toFixed(1)}¢/L`}
                          </td>
                          <td class="p-3.5 text-emerald-400 font-bold">
                            ${costPer100.toFixed(2)} CAD
                          </td>
                          <td class="p-3.5 text-neon-cyan font-bold">
                            ${annualCost.toLocaleString()} CAD
                          </td>
                          <td class="p-3.5 text-right font-bold text-slate-200">
                            ${monthlyCost} / mo
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- 3. Interactive Calculators Section -->
          <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl">
            <h2 class="text-2xl font-display font-black text-white mb-6 flex items-center gap-2">
              <span>🎛️</span> Canadian Cost & Winter Calculators
            </h2>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              <div>
                <h3 class="text-sm font-mono text-neon-cyan uppercase tracking-wider font-bold mb-3">💰 Custom Commute & Fuel Calculator</h3>
                <FuelCostCalculator client:visible vehicle={vehicle} provinces={provinces} defaultProvinceCode="ON" />
              </div>
              <div>
                <h3 class="text-sm font-mono text-rose-400 uppercase tracking-wider font-bold mb-3">❄️ Winter Degradation Meter (-15°C)</h3>
                <WinterPenaltyMeter client:visible vehicle={vehicle} />
              </div>
            </div>
          </div>

          <!-- 4. Sibling Trims Comparison -->
          {siblingTrims.length > 1 && (
            <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl">
              <h2 class="text-2xl font-display font-black text-white mb-1">
                Compare All {vehicle.year} {vehicle.make} {vehicle.model} Trims
              </h2>
              <p class="text-xs text-slate-400 font-mono mb-6">Switch between available Canadian trim packages</p>

              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                {siblingTrims.map(sib => (
                  <a
                    href={`/makes/${make}/${model}/${year}/${toSlug(sib.trim)}`}
                    class={`p-4 rounded-2xl border transition-all flex flex-col justify-between ${
                      sib.id === vehicle.id 
                        ? 'bg-neon-cyan/10 border-neon-cyan shadow-lg shadow-cyan-500/10 ring-1 ring-neon-cyan' 
                        : 'bg-[#06080C] border-white/[0.08] hover:border-white/20'
                    }`}
                  >
                    <div>
                      <div class="flex items-center justify-between mb-1.5">
                        <span class="text-[10px] font-mono text-slate-400">{sib.driveType}</span>
                        <span class={fuelTypePill(sib.fuelType)}>{fuelTypeLabel(sib.fuelType).split(' ')[0]}</span>
                      </div>
                      <h3 class="font-bold text-white text-sm mb-1">{sib.trim}</h3>
                      <div class="text-xs font-mono text-emerald-400 font-bold mb-2">
                        {sib.combinedL100km ? `${sib.combinedL100km} L/100km` : `${sib.kwhPer100km} kWh`}
                      </div>
                    </div>

                    <div class="pt-2 border-t border-white/[0.06] flex items-center justify-between text-xs">
                      <span class="text-slate-400 font-mono">${(sib.msrpCAD / 1000).toFixed(1)}k CAD</span>
                      <span class={sib.id === vehicle.id ? 'text-neon-cyan font-bold text-[11px]' : 'text-slate-400 hover:text-white text-[11px]'}>
                        {sib.id === vehicle.id ? 'Viewing ●' : 'View →'}
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- 5. 🍁 Comprehensive Canadian Road Test & Ownership Review -->
          <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-6">
            <div>
              <span class="text-xs font-mono text-neon-cyan uppercase tracking-widest font-semibold block mb-1">🍁 Real-World Canadian Driving</span>
              <h2 class="text-2xl font-display font-black text-white">
                {vehicle.year} {vehicle.make} {vehicle.model} ({vehicle.trim}) Review
              </h2>
            </div>

            <div class="space-y-4 text-sm text-slate-300 leading-relaxed">
              <p>
                When driving the <strong>{vehicle.year} {vehicle.make} {vehicle.model} {vehicle.trim}</strong> on Canadian roads, fuel economy numbers are only half the story. 
                Whether you are merging onto Toronto's Highway 401 in rush hour, commuting along Calgary's Deerfoot Trail in sub-zero January weather, or cruising the Sea-to-Sky highway in British Columbia, 
                this vehicle delivers an official EnerGuide combined rating of <strong>{vehicle.combinedL100km ? `${vehicle.combinedL100km} L/100km` : `${vehicle.kwhPer100km} kWh/100km`}</strong>.
              </p>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                <div class="p-4 rounded-2xl bg-[#06080C] border border-white/[0.06]">
                  <h3 class="text-white font-bold mb-1.5 flex items-center gap-1.5">
                    <span>🛣️</span> Highway & Passing Power
                  </h3>
                  <p class="text-xs text-slate-400 leading-relaxed">
                    At Canadian highway speeds of 110 to 120 km/h, the {vehicle.transmission} keeps engine revs low and steady. 
                    With {vehicle.driveType} traction, lane changes over highway slush and wet pavement feel predictable and composed.
                  </p>
                </div>

                <div class="p-4 rounded-2xl bg-[#06080C] border border-white/[0.06]">
                  <h3 class="text-white font-bold mb-1.5 flex items-center gap-1.5">
                    <span>🏙️</span> City Commuting & Stop-and-Go
                  </h3>
                  <p class="text-xs text-slate-400 leading-relaxed">
                    In heavy metropolitan traffic across Vancouver, Montreal, or Ottawa, official city consumption is 
                    <strong>{vehicle.cityL100km ? `${vehicle.cityL100km} L/100km` : `${vehicle.cityLe100km || vehicle.kwhPer100km} Le/100km`}</strong>. 
                    Low-speed throttle response is smooth and easy to modulate in tight parking structures.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- 6. ❄️ Deep Cold Weather & Canadian Winter Reality Guide -->
          <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-6">
            <div>
              <span class="text-xs font-mono text-rose-400 uppercase tracking-widest font-semibold block mb-1">❄️ Winter Performance (-15°C to -30°C)</span>
              <h2 class="text-2xl font-display font-black text-white">
                How Canadian Cold Weather Affects the {vehicle.trim}
              </h2>
            </div>

            <div class="space-y-4 text-sm text-slate-300 leading-relaxed">
              <p>
                Official lab ratings are measured at 20°C in heated test facilities. In real Canadian winters, sub-zero temperatures change how energy is consumed:
              </p>

              <div class="space-y-3">
                <div class="p-4 rounded-2xl bg-[#06080C] border border-rose-500/20">
                  <h3 class="text-rose-400 font-bold mb-1 text-sm">
                    {isEV ? '⚡ Battery Cold Soak & Range Loss' : '⛽ Cold Start & Winter Blend Fuel Penalty'}
                  </h3>
                  <p class="text-xs text-slate-400 leading-relaxed">
                    {isEV 
                      ? `When the temperature drops to -15°C in Edmonton or Winnipeg, expect your effective range to decrease by approximately 30% to 35% (down from ${vehicle.electricRangeKm} km to roughly ${Math.round((vehicle.electricRangeKm || 400) * 0.68)} km). Most of this power goes toward heating the cabin and maintaining proper battery pack temperatures. Pre-heating the vehicle while plugged into a Level 2 home charger preserves significant driving range.`
                      : `During sub-zero cold starts, the ${vehicle.engineSize}L engine runs in an open-loop fuel enrichment cycle to reach operating temperature and provide cabin heat. Combined with lower-energy winter gasoline blends and increased rolling resistance from dedicated winter tires, expect fuel consumption to rise by 12% to 18% over summer figures.`}
                  </p>
                </div>

                <div class="p-4 rounded-2xl bg-[#06080C] border border-white/[0.06]">
                  <h3 class="text-white font-bold mb-1 text-sm">🛞 Winter Tire Fitment & Salt Protection</h3>
                  <p class="text-xs text-slate-400 leading-relaxed">
                    Installing a dedicated set of 3-Peak Mountain Snowflake (3PMSF) winter tires on the {vehicle.trim} is mandatory in Quebec between December 1 and March 15, and strongly recommended on all BC mountain passes and Prairie highways. Annual anti-corrosion spray treatments help protect the underbody chassis from harsh calcium chloride and road brine used across Eastern Canada.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- 7. 💡 Buyer's Verdict & Canadian Maintenance Guide -->
          <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-6">
            <div>
              <span class="text-xs font-mono text-emerald-400 uppercase tracking-widest font-semibold block mb-1">💡 Canadian Buyer's Verdict</span>
              <h2 class="text-2xl font-display font-black text-white">
                Should You Buy the {vehicle.year} {vehicle.make} {vehicle.model} {vehicle.trim}?
              </h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
              <div class="p-4 rounded-2xl bg-emerald-500/5 border border-emerald-500/20">
                <div class="text-emerald-400 font-bold text-sm mb-2 flex items-center gap-1.5">
                  <span>✓</span> Great Choice For:
                </div>
                <ul class="space-y-2 text-slate-300">
                  <li class="flex items-start gap-1.5">
                    <span class="text-emerald-400 font-bold">•</span>
                    <span>Daily commuters looking for reliable {vehicle.driveType} all-weather traction.</span>
                  </li>
                  <li class="flex items-start gap-1.5">
                    <span class="text-emerald-400 font-bold">•</span>
                    <span>Drivers seeking predictable Canadian ownership costs with a starting MSRP of ${vehicle.msrpCAD.toLocaleString()} CAD.</span>
                  </li>
                  <li class="flex items-start gap-1.5">
                    <span class="text-emerald-400 font-bold">•</span>
                    <span>Long-distance road trips requiring good cruising range between fill-ups.</span>
                  </li>
                </ul>
              </div>

              <div class="p-4 rounded-2xl bg-amber-500/5 border border-amber-500/20">
                <div class="text-amber-400 font-bold text-sm mb-2 flex items-center gap-1.5">
                  <span>⚠️</span> Consider Alternatives If:
                </div>
                <ul class="space-y-2 text-slate-300">
                  <li class="flex items-start gap-1.5">
                    <span class="text-amber-400 font-bold">•</span>
                    <span>You frequently tow heavy trailers or work equipment requiring high payload ratings.</span>
                  </li>
                  <li class="flex items-start gap-1.5">
                    <span class="text-amber-400 font-bold">•</span>
                    <span>You live in remote northern territories without reliable access to local service dealers.</span>
                  </li>
                  <li class="flex items-start gap-1.5">
                    <span class="text-amber-400 font-bold">•</span>
                    <span>You prefer a larger three-row passenger vehicle for full-size family carpooling.</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 8. ❓ Frequently Asked Canadian Questions (FAQ) -->
          <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-4">
            <h2 class="text-2xl font-display font-black text-white mb-2">
              Frequently Asked Questions About the {vehicle.year} {vehicle.make} {vehicle.model}
            </h2>
            <p class="text-xs text-slate-400 mb-6">Common questions asked by Canadian buyers and vehicle owners</p>

            <div class="space-y-3">
              {[
                {
                  q: `What is the official Canadian fuel consumption rating for the ${vehicle.year} ${vehicle.make} ${vehicle.model} ${vehicle.trim}?`,
                  a: `According to Natural Resources Canada (NRCan) EnerGuide testing, the ${vehicle.year} ${vehicle.make} ${vehicle.model} ${vehicle.trim} achieves a combined rating of ${vehicle.combinedL100km ? `${vehicle.combinedL100km} L/100km (${vehicle.cityL100km} city / ${vehicle.hwyL100km} highway)` : `${vehicle.kwhPer100km} kWh/100km with an electric range of ${vehicle.electricRangeKm} km`}.`,
                },
                {
                  q: `How much will I spend on fuel or electricity each month in Ontario or Quebec?`,
                  a: `Based on a standard Canadian commute of 20,000 km per year, driving the ${vehicle.trim} costs approximately $${Math.round((vehicle.combinedL100km || 7.5) * 1.55 * 200 / 12)} to $${Math.round((vehicle.combinedL100km || 7.5) * 1.70 * 200 / 12)} CAD per month depending on current pump prices and electricity tariffs in your province.`,
                },
                {
                  q: `Does the ${vehicle.year} ${vehicle.make} ${vehicle.model} require premium gasoline?`,
                  a: vehicle.fuelType === 'Z' 
                    ? `Yes, the ${vehicle.make} ${vehicle.model} is engineered for 91-octane premium gasoline to deliver its rated horsepower, fuel efficiency, and protect engine components under load.` 
                    : `No, this vehicle runs on standard 87-octane regular unleaded gasoline, helping keep your fuel fill-up costs lower across Canadian gas stations.`,
                },
                {
                  q: `How does the ${vehicle.driveType} drivetrain perform in heavy Canadian snow?`,
                  a: `The ${vehicle.driveType} setup combined with modern electronic stability and traction control delivers confident grip during typical Canadian winter conditions. Pairing it with quality winter tires provides the shortest stopping distances and maximum stability on icy roads.`,
                },
                {
                  q: `How can I check if this ${vehicle.make} ${vehicle.model} has any outstanding Transport Canada safety recalls?`,
                  a: `You can check our Recalls Directory above or verify your 17-digit Vehicle Identification Number (VIN) directly on the official Transport Canada Motor Vehicle Safety Recalls database at tc.canada.ca. Authorized franchise dealers perform all recall repairs free of charge.`,
                },
              ].map(({ q, a }) => (
                <details class="group rounded-2xl bg-[#06080C] border border-white/[0.06] hover:border-white/[0.12] transition-colors overflow-hidden">
                  <summary class="flex justify-between items-center gap-3 p-4 sm:p-5 cursor-pointer list-none select-none">
                    <span class="font-bold text-white text-sm group-open:text-neon-cyan transition-colors">{q}</span>
                    <svg class="w-4 h-4 shrink-0 text-slate-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <div class="px-4 sm:px-5 pb-4 text-xs text-slate-300 leading-relaxed border-t border-white/[0.04] pt-3">
                    {a}
                  </div>
                </details>
              ))}
            </div>
          </div>

        </div>

        <!-- ── Right Column: Sticky Intelligence Sidebar (4 Cols) ────── -->
        <aside class="lg:col-span-4 relative h-full">
          <div class="sticky top-24 space-y-6">
            
            <!-- 1. Executive Quick Spec Card -->
            <div class="p-6 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl">
              <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/[0.06]">
                <span class="text-xs font-mono font-bold text-white uppercase tracking-wider">Trim Quick Specs</span>
                <span class="text-xs font-mono text-neon-cyan font-bold">{vehicle.year} {vehicle.make}</span>
              </div>

              <div class="space-y-3 text-xs font-mono">
                <div class="flex justify-between items-center text-slate-300">
                  <span class="text-slate-400">Starting MSRP:</span>
                  <span class="font-bold text-white">${vehicle.msrpCAD.toLocaleString()} CAD</span>
                </div>
                <div class="flex justify-between items-center text-slate-300">
                  <span class="text-slate-400">Engine / Motor:</span>
                  <span class="font-bold text-slate-200">{vehicle.engineSize > 0 ? `${vehicle.engineSize}L (${vehicle.transmission})` : 'Electric Drive'}</span>
                </div>
                <div class="flex justify-between items-center text-slate-300">
                  <span class="text-slate-400">Drivetrain:</span>
                  <span class="font-bold text-neon-cyan">{vehicle.driveType}</span>
                </div>
                <div class="flex justify-between items-center text-slate-300">
                  <span class="text-slate-400">Fuel Tank / Batt:</span>
                  <span class="font-bold text-slate-200">{vehicle.fuelTankLitres ? `${vehicle.fuelTankLitres} Litres` : 'Direct Electric'}</span>
                </div>
                <div class="flex justify-between items-center text-slate-300">
                  <span class="text-slate-400">CO₂ Output:</span>
                  <span class="font-bold text-slate-200">{vehicle.co2GPerKm} g/km</span>
                </div>
                <div class="flex justify-between items-center text-slate-300 pt-2 border-t border-white/[0.04]">
                  <span class="text-slate-400">Safety Status:</span>
                  <span class="text-emerald-400 font-bold flex items-center gap-1">
                    <span>✓</span> Transport Canada Verified
                  </span>
                </div>
              </div>

              <a 
                href="/recalls" 
                class="mt-5 w-full py-2.5 px-3 rounded-xl bg-red-500/10 border border-red-500/20 text-rose-400 hover:bg-red-500/15 text-xs font-mono font-bold text-center block transition-colors"
              >
                ⚠️ Check Transport Canada Recalls →
              </a>
            </div>

            <!-- 2. Lead Generation & Insurance Widget -->
            <LeadGenWidget
              client:visible
              vehicleMake={vehicle.make}
              vehicleModel={vehicle.model}
              vehicleYear={vehicle.year}
              isEV={isEV || isPlugin}
            />

          </div>
        </aside>

      </div>
    </div>
  </section>
</BaseLayout>


