---
// src/pages/privacy.astro
// Comprehensive Canadian Privacy Policy — PIPEDA, CASL & Google AdSense Standards
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../lib/schema.ts';

const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Privacy Policy', url: '/privacy' },
  ]),
];
---

<BaseLayout
  title="Privacy Policy & Data Governance | RangeAndFuel.ca"
  description="Comprehensive Canadian Privacy Policy for RangeAndFuel.ca. Compliant with PIPEDA, CASL, Quebec Law 25, Google AdSense publisher requirements, and international privacy standards."
  canonical="/privacy"
  jsonLd={jsonLd}
>
  <!-- Breadcrumb Bar -->
  <div class="border-b border-white/[0.06] bg-[#07090E]/80 backdrop-blur-md">
    <div class="container-site py-3">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-xs text-slate-400 font-mono">
          <li><a href="/" class="hover:text-neon-cyan transition-colors">Home</a></li>
          <li class="text-slate-600">/</li>
          <li class="text-slate-200 font-medium">Privacy Policy</li>
        </ol>
      </nav>
    </div>
  </div>

  <section class="py-16 md:py-20 bg-[#06080C] relative overflow-hidden">
    <!-- Ambient Background Glow -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-gradient-to-b from-neon-cyan/15 via-emerald-500/5 to-transparent blur-3xl pointer-events-none rounded-full"></div>

    <div class="container-site max-w-4xl relative z-10">
      
      <!-- Page Header -->
      <div class="mb-12 border-b border-white/[0.08] pb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono mb-4">
          <span>🛡️</span> PIPEDA & CASL Certified Compliance
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-black text-white tracking-tight">
          Privacy <span class="text-gradient-cyan">Policy</span>
        </h1>
        <p class="text-xs font-mono text-slate-400 mt-3">
          Last Revised: September 2, 2026 · Compliant with Canadian Federal PIPEDA, CASL, Quebec Law 25, and Google Publisher Standards
        </p>
      </div>

      <!-- Legal Document Stream -->
      <div class="space-y-8 text-slate-300 text-sm leading-relaxed">
        
        <!-- Section 1 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="text-neon-cyan font-mono">01.</span> Commitment to Canadian Consumer Privacy
          </h2>
          <p>
            At <strong>RangeAndFuel.ca</strong> ("we," "our," "us," or "the Platform"), we are deeply dedicated to protecting the privacy, confidentiality, and security of all Canadian and international visitors who access our automotive intelligence portal. We operate in strict compliance with the Canadian federal <em>Personal Information Protection and Electronic Documents Act</em> (PIPEDA), substantial provincial privacy equivalents (including British Columbia’s <em>Personal Information Protection Act</em>, Alberta’s <em>Personal Information Protection Act</em>, and Quebec’s <em>Act respecting the protection of personal information in the private sector</em> / Law 25), Canada's Anti-Spam Legislation (CASL), and global consumer protection mandates such as the EU General Data Protection Regulation (GDPR) and the California Consumer Privacy Act (CCPA/CPRA).
          </p>
          <p>
            This Privacy Policy sets forth in detail how we collect, process, store, disclose, and protect personal and non-personal technical information when you browse our vehicle catalog, utilize our interactive fuel and winter range calculators, review Transport Canada recall notices, or interact with third-party service partners.
          </p>
        </div>

        <!-- Section 2 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="text-neon-cyan font-mono">02.</span> Information We Collect & Processing Methods
          </h2>
          <p>
            RangeAndFuel.ca is engineered as an open, accessible public intelligence platform. We do not require visitors to register user accounts, provide credit card numbers, or reveal sensitive personal identifiers simply to inspect fuel economy metrics or compare vehicle models. We categorize collected information into two distinct classifications:
          </p>
          
          <div class="space-y-3 pt-2">
            <div class="p-4 rounded-2xl bg-[#06080C] border border-white/[0.04]">
              <h3 class="text-white font-bold text-sm mb-1">A. Technical & Aggregated Telemetry Data (Automated)</h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                When you access our platform, our Content Delivery Network (CDN) and edge server infrastructure automatically log standard, non-personally identifiable technical telemetry. This includes: browser user-agent string, operating system version, device display resolution, referring URL, timestamp of requests, page response latencies, and regional geographic routing data (at the provincial or municipal network level, without precision GPS tracking). This telemetry is utilized exclusively to maintain high-speed caching, thwart Distributed Denial of Service (DDoS) cyber threats, and verify Core Web Vitals performance.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-[#06080C] border border-white/[0.04]">
              <h3 class="text-white font-bold text-sm mb-1">B. Voluntarily Submitted Information</h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                If you elect to contact our editorial staff, submit feedback via email, or interact with optional partner referral forms (such as auto insurance rate comparisons, pre-owned trade-in valuations, or residential Level 2 EV charging equipment quotes), you may voluntarily supply personal contact data such as your name, email address, postal code, or vehicle year/make/model details. Any such data is collected strictly with your explicit consent.
              </p>
            </div>
          </div>
        </div>

        <!-- Section 3 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="text-neon-cyan font-mono">03.</span> Cookies, Web Beacons & Google AdSense Advertising
          </h2>
          <p>
            To sustain our platform as a 100% free public service for Canadian drivers, RangeAndFuel.ca partners with trusted third-party advertising vendors and programmatic advertising networks, including <strong>Google LLC (Google AdSense)</strong>.
          </p>
          <p>
            Google and third-party advertising partners utilize HTTP cookies, web beacons, and unique mobile identifiers to serve relevant, contextual advertisements to visitors of this website:
          </p>
          <ul class="list-disc pl-5 space-y-2 text-slate-400">
            <li><strong>Google DoubleClick DART Cookies:</strong> Google uses cookies (including the DoubleClick cookie) to serve advertisements to users based on their prior visits to RangeAndFuel.ca and other websites across the broader internet.</li>
            <li><strong>Personalized vs. Non-Personalized Advertising:</strong> In compliance with Google AdSense Publisher Policies, users have full autonomy over whether advertisements are personalized based on browsing history or delivered contextually based purely on the automotive content of the current page.</li>
            <li><strong>Third-Party Ad Networks:</strong> Authorized third-party ad networks or ad servers may measure advertising campaign effectiveness and personalize ad content displayed on our pages using cookie identifiers.</li>
          </ul>
        </div>

        <!-- Section 4 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="text-neon-cyan font-mono">04.</span> User Rights & Comprehensive Cookie Opt-Out Mechanisms
          </h2>
          <p>
            You have full sovereignty over how cookies and advertising trackers operate on your computer or mobile device. You may exercise your privacy rights and disable personalized advertising through multiple official consumer opt-out portals:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-2xl bg-[#06080C] border border-white/[0.04]">
              <div class="font-bold text-white text-xs mb-1">Google Ad Settings</div>
              <p class="text-xs text-slate-400 mb-2">Manage Google ad personalization, topic preferences, and demographic advertising parameters directly.</p>
              <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer" class="text-neon-cyan text-xs underline font-mono">
                Google Ads Settings ↗
              </a>
            </div>

            <div class="p-4 rounded-2xl bg-[#06080C] border border-white/[0.04]">
              <div class="font-bold text-white text-xs mb-1">Digital Advertising Alliance of Canada (DAAC)</div>
              <p class="text-xs text-slate-400 mb-2">Opt out of interest-based digital advertising across participating Canadian advertising networks.</p>
              <a href="https://youradchoices.ca" target="_blank" rel="noopener noreferrer" class="text-neon-cyan text-xs underline font-mono">
                YourAdChoices.ca ↗
              </a>
            </div>

            <div class="p-4 rounded-2xl bg-[#06080C] border border-white/[0.04]">
              <div class="font-bold text-white text-xs mb-1">Network Advertising Initiative (NAI)</div>
              <p class="text-xs text-slate-400 mb-2">Universal multi-network opt-out tool for behavioral digital advertising across global networks.</p>
              <a href="https://optout.networkadvertising.org" target="_blank" rel="noopener noreferrer" class="text-neon-cyan text-xs underline font-mono">
                NAI Consumer Opt-Out ↗
              </a>
            </div>

            <div class="p-4 rounded-2xl bg-[#06080C] border border-white/[0.04]">
              <div class="font-bold text-white text-xs mb-1">Browser Cookie Controls</div>
              <p class="text-xs text-slate-400 mb-2">Configure Google Chrome, Apple Safari, Mozilla Firefox, or Microsoft Edge to block third-party cookies globally.</p>
              <span class="text-slate-400 text-xs font-mono">Browser Settings ➔ Privacy</span>
            </div>
          </div>
        </div>

        <!-- Section 5 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="text-neon-cyan font-mono">05.</span> Affiliate Referral Links & Sponsored Partnerships
          </h2>
          <p>
            RangeAndFuel.ca participates in transparent commercial affiliate marketing programs. Certain product links and lead-generation modules (e.g., Canadian automotive insurance rate comparison widgets, vehicle trade-in valuation services, and residential Level 2 EV charging hardware vendors) contain affiliate tracking parameters.
          </p>
          <p>
            In strict compliance with Canadian Competition Bureau guidelines, Federal Trade Commission (FTC) regulations, and Google Search Quality Evaluator Guidelines, we adhere to the following principles:
          </p>
          <ul class="list-disc pl-5 space-y-2 text-slate-400">
            <li>All commercial affiliate hyperlinks are tagged with required <code>rel="sponsored"</code> or <code>rel="nofollow"</code> attributes to ensure absolute search engine compliance.</li>
            <li>Clicking an affiliate link does NOT increase any retail purchase price or insurance premium for the Canadian consumer.</li>
            <li>Editorial integrity is uncompromised: our mathematical fuel efficiency ratings, L/100km EnerGuide calculations, and -15°C winter degradation penalties are calculated strictly from official government testing datasets without commercial bias.</li>
          </ul>
        </div>

        <!-- Section 6 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="text-neon-cyan font-mono">06.</span> Canadian Anti-Spam Legislation (CASL) Compliance
          </h2>
          <p>
            RangeAndFuel.ca strictly adheres to Canada’s Anti-Spam Legislation (CASL, S.C. 2010, c. 23). We maintain a strict zero-tolerance policy regarding unsolicited commercial electronic messages (spam).
          </p>
          <p>
            We will never send commercial electronic messages, newsletters, or marketing alerts without your prior express, verifiable opt-in consent. Every electronic communication dispatched by our platform contains a functional, one-click unsubscribe mechanism, clear identification of RangeAndFuel.ca as the sender, and valid Canadian postal and electronic contact information. Unsubscribe requests are processed immediately and unconditionally within ten (10) business days.
          </p>
        </div>

        <!-- Section 7 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="text-neon-cyan font-mono">07.</span> Data Security, Storage & Cross-Border Data Transfers
          </h2>
          <p>
            We employ enterprise-grade administrative, technical, and physical safeguards to prevent unauthorized access, alteration, disclosure, or destruction of technical telemetry and user data. All data transmission across RangeAndFuel.ca is encrypted using Transport Layer Security (TLS 1.3 / HTTPS encryption).
          </p>
          <p>
            While our primary operations are focused on the Canadian market, technical data and CDN server caches may be hosted on secure cloud infrastructure located within Canada, the United States, or other international jurisdictions. By utilizing our platform, you acknowledge that your technical telemetry may be stored on servers subject to the lawful access requests of courts and law enforcement authorities in those respective jurisdictions under local legal statutes.
          </p>
        </div>

        <!-- Section 8 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="text-neon-cyan font-mono">08.</span> Children's Privacy Protection (COPPA & Canadian Standards)
          </h2>
          <p>
            RangeAndFuel.ca is designed and intended exclusively for general adult audiences, licensed motorists, and prospective vehicle buyers. We do not knowingly solicit, collect, or maintain personally identifiable information from children under the age of thirteen (13), or under the applicable age of majority in their province of residence. If we discover that personal information of a minor has been inadvertently submitted to our servers without verified parental consent, we will promptly delete that data from our records.
          </p>
        </div>

        <!-- Section 9 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="text-neon-cyan font-mono">09.</span> User Access, Correction & Deletion Rights (PIPEDA Principle 9)
          </h2>
          <p>
            Under Canadian PIPEDA Principle 9 and relevant provincial privacy statutes, you possess the legal right to challenge the accuracy and completeness of any personal information we may hold regarding you and have it amended or erased as appropriate.
          </p>
          <p>
            You may request: (i) confirmation of whether we maintain personal data relating to you; (ii) an accounting of the third parties to whom that data has been disclosed; (iii) correction of inaccurate or outdated records; or (iv) complete deletion of your voluntary contact submissions from our active databases.
          </p>
        </div>

        <!-- Section 10 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-[#0D1117] border border-white/[0.08] shadow-xl space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="text-neon-cyan font-mono">10.</span> Privacy Officer Contact Information
          </h2>
          <p>
            For privacy inquiries, formal access requests, CASL inquiries, or feedback regarding our privacy practices, please contact our designated Canadian Privacy Officer:
          </p>
          <div class="p-4 rounded-2xl bg-[#06080C] border border-white/[0.06] text-xs font-mono space-y-1">
            <div class="text-white font-bold">Privacy Officer & Data Protection Officer</div>
            <div class="text-slate-400">RangeAndFuel.ca Canadian Operations</div>
            <div class="text-neon-cyan">Email: privacy@rangeandfuel.ca</div>
            <div class="text-slate-500">Website: https://rangeandfuel.ca</div>
            <div class="text-slate-500">Jurisdiction: Ontario, Canada</div>
          </div>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>

