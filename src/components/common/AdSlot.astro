---
// src/components/common/AdSlot.astro
// Google AdSense Ad Unit Container
// IMPORTANT: ADSENSE_ENABLED = false until official AdSense approval is received.
// Do NOT show any ad placeholders or ad spaces before approval.
// After approval: set ADSENSE_ENABLED = true and replace Publisher ID + Slot IDs.

interface Props {
  slotId?: string;
  adClient?: string;
  format?: 'auto' | 'rectangle' | 'horizontal' | 'fluid';
  label?: string;
  className?: string;
  minHeight?: string;
}

// ─── MONETIZATION SWITCH ────────────────────────────────────────────────────
// DO NOT set to true until Google AdSense approves https://rangeandfuel.ca
// After approval:
//   1. Replace PUBLISHER_ID with your real ca-pub-XXXXXXXXXXXXXXXX
//   2. Replace slotId defaults with real slot IDs from AdSense dashboard
//   3. Set ADSENSE_ENABLED = true
// ───────────────────────────────────────────────────────────────────────────
const ADSENSE_ENABLED = false;
const PUBLISHER_ID    = 'ca-pub-XXXXXXXXXXXXXXXX';

const {
  slotId    = '1234567890',
  adClient  = PUBLISHER_ID,
  format    = 'auto',
  label     = 'Advertisement',
  className = '',
  minHeight = '120px',
} = Astro.props;

const isLive = ADSENSE_ENABLED && adClient !== 'ca-pub-XXXXXXXXXXXXXXXX';
---

{isLive && (
  <div class={`w-full my-6 text-center ${className}`} style={`min-height: ${minHeight};`}>
    <p class="text-[10px] font-mono tracking-widest uppercase text-slate-500 mb-1">{label}</p>
    <ins
      class="adsbygoogle"
      style="display:block;"
      data-ad-client={adClient}
      data-ad-slot={slotId}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`}
      crossorigin="anonymous"
    ></script>
  </div>
)}
