---
// src/components/common/AdSlot.astro
// Google AdSense Ad Unit Container
// IMPORTANT: ADSENSE_ENABLED = false until official AdSense approval is received.
// Do NOT show any ad placeholders or ad spaces before approval.
// After approval: set ADSENSE_ENABLED = true and replace Publisher ID + Slot IDs.

interface Props {
  slotId?: string;
  adClient?: string;
  format?: 'auto' | 'rectangle' | 'horizontal' | 'fluid';
  label?: string;
  className?: string;
  minHeight?: string;
}

// ─── MONETIZATION SWITCH ────────────────────────────────────────────────────
// DO NOT set to true until Google AdSense approves https://rangeandfuel.ca
// After approval:
//   1. Replace PUBLISHER_ID with your real ca-pub-XXXXXXXXXXXXXXXX
//   2. Replace slotId defaults with real slot IDs from AdSense dashboard
//   3. Set ADSENSE_ENABLED = true
// ───────────────────────────────────────────────────────────────────────────
const ADSENSE_ENABLED = false;
const PUBLISHER_ID    = 'ca-pub-XXXXXXXXXXXXXXXX';

const {
  slotId    = '1234567890',
  adClient  = PUBLISHER_ID,
  format    = 'auto',
  label     = 'Advertisement',
  className = '',
  minHeight = format === 'rectangle' ? '280px' : format === 'horizontal' ? '100px' : '250px',
} = Astro.props;

const isLive = ADSENSE_ENABLED && adClient !== 'ca-pub-XXXXXXXXXXXXXXXX';
---

{isLive && (
  <div 
    class={`ad-slot-container w-full my-8 text-center transition-all ${className}`} 
    style={`min-height: ${minHeight}; contain: layout style; content-visibility: auto;`}
  >
    <div class="ad-inner-wrapper max-w-full mx-auto inline-block">
      <p class="ad-label text-[10px] font-mono tracking-widest uppercase text-slate-500 mb-1.5 select-none" aria-hidden="true">
        {label}
      </p>
      <ins
        class="adsbygoogle"
        style={`display:block; min-height: ${minHeight};`}
        data-ad-client={adClient}
        data-ad-slot={slotId}
        data-ad-format={format}
        data-full-width-responsive="true"
      ></ins>
      <script is:inline>
        (function() {
          try {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          } catch (e) {
            console.warn('AdSense slot execution error:', e);
          }
        })();
      </script>
    </div>
  </div>
)}

<style>
  /* Automatically collapse the entire container if Google AdSense returns no ad */
  .ad-slot-container:has(ins[data-ad-status="unfilled"]) {
    display: none !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }
</style>
